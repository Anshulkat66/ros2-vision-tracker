<?xml version="1.0"?>

<sdf version="1.8">

<model name="red_sphere">

    <pose>3 0 0.5 0 0 0</pose>

    <static>false</static>

    <link name="link">

        <inertial>
            <mass>1</mass>
            <inertia>
                <ixx>0.1</ixx>
                <iyy>0.1</iyy>
                <izz>0.1</izz>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyz>0</iyz>
            </inertia>
        </inertial>


        <visual name="visual">

            <geometry>
                <sphere>
                    <radius>0.3</radius>
                </sphere>
            </geometry>

            <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
                <specular>0.5 0.5 0.5 1</specular>
            </material>

        </visual>


        <collision name="collision">

            <geometry>
                <sphere>
                    <radius>0.3</radius>
                </sphere>
            </geometry>

        </collision>


    </link>

</model>

</sdf>